---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags: string[];
}

const { title, description, pubDate, category, tags } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — minjun.log`} description={description}>
  <div class="page-wrapper">
    <article class="post-article">
      <header class="post-header">
        <div class="post-meta">
          <span class="tag">{category}</span>
          <span class="post-date">{formattedDate}</span>
        </div>
        <h1>{title}</h1>
        <p class="post-description">{description}</p>
        <div class="post-tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      </header>

      <div class="post-body">
        <slot />
      </div>

      <div class="post-footer">
        <a href="/blog" class="back-link">← Back to Blog</a>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .post-article {
    padding: 3rem 0 4rem;
    max-width: 700px;
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .post-header .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .post-header h1 {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .post-description {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .post-body {
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .post-body h2 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 2rem 0 0.75rem;
  }

  .post-body h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
  }

  .post-body p {
    margin-bottom: 1.25rem;
    color: #333;
  }

  .post-body pre {
    background: #f6f6f6;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .post-body code {
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.875em;
    background: #f0f0f0;
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .post-body pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .post-body ul,
  .post-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .post-body li {
    margin-bottom: 0.4rem;
    color: #333;
  }

  .post-body blockquote {
    border-left: 3px solid var(--border);
    padding-left: 1rem;
    color: var(--text-muted);
    margin: 1.5rem 0;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .back-link {
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--text);
  }
</style>
