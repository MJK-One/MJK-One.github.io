---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags: string[];
}

const { title, description, pubDate, category, tags } = Astro.props;

const d = pubDate;
const dateStr = `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`;

const catColor: Record<string, string> = {
  'Spring Boot': 'tb', Java: 'tb', JPA: 'tb', 'Spring Security': 'tb',
  Redis: 'tp', MySQL: 'tg', PostgreSQL: 'tc', Oracle: 'tg',
  Docker: 'tc', AWS: 'to', 'GitHub Actions': 'tg',
  JavaScript: 'to', JWT: 'tv', Architecture: 'tv',
  performance: 'tp', devops: 'tc', architecture: 'tv', troubleshooting: 'tp',
};
---

<BaseLayout title={`${title} — minjun.log`} description={description}>
  <div class="page-wrapper">
    <article class="post-article">

      <header class="post-header">
        <div class="post-header-meta">
          <span class={`tag ${catColor[category] ?? 'tb'}`}>{category}</span>
          <span class="post-date">{dateStr}</span>
        </div>
        <h1>{title}</h1>
        <p class="post-description">{description}</p>
        <div class="post-tags">
          {tags.map(tag => <span class={`tag ${catColor[tag] ?? 'tb'}`}>{tag}</span>)}
        </div>
      </header>

      <div class="post-body">
        <slot />
      </div>

      <div class="post-footer">
        <a href="/blog" class="back-link">← 블로그로 돌아가기</a>
      </div>

    </article>
  </div>
</BaseLayout>

<style>
.post-article {
  padding: 3rem 0 5rem;
  max-width: 680px;
}

.post-header {
  margin-bottom: 2.5rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--border);
}

.post-header-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.post-header h1 {
  font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif;
  font-size: 1.5rem;
  font-weight: 500;
  color: var(--text);
  letter-spacing: -0.02em;
  line-height: 1.4;
  margin-bottom: 0.75rem;
}

.post-description {
  font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif;
  font-size: 0.9rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 1rem;
}

/* ── Post body ───────────────────────────── */
.post-body {
  font-size: 0.9rem;
  line-height: 1.9;
}

.post-body :global(h2) {
  font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif;
  font-size: 1rem;
  font-weight: 500;
  color: var(--text);
  margin: 2.2rem 0 0.8rem;
  padding-bottom: 0.4rem;
  border-bottom: 1px solid var(--border);
}

.post-body :global(h3) {
  font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--accent-2);
  margin: 1.6rem 0 0.5rem;
}

.post-body :global(p) {
  font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif;
  color: var(--text-muted);
  margin-bottom: 1rem;
}

.post-body :global(strong) {
  color: var(--text);
  font-weight: 500;
}

.post-body :global(pre) {
  font-family: 'JetBrains Mono', monospace !important;
  font-size: 0.82rem;
  background: var(--bg-code);
  border: 1px solid var(--border);
  border-radius: 7px;
  padding: 1.2rem;
  overflow-x: auto;
  margin: 1.2rem 0;
  line-height: 1.65;
}

/* pre 안의 code — 반드시 JetBrains Mono 고정 */
.post-body :global(pre code) {
  font-family: 'JetBrains Mono', monospace !important;
  font-size: inherit;
  background: none;
  border: none;
  padding: 0;
  color: inherit;
  border-radius: 0;
}

/* 인라인 코드 */
.post-body :global(:not(pre) > code) {
  font-family: 'JetBrains Mono', monospace !important;
  font-size: 0.82em;
  background: var(--bg-code);
  color: #86e1fc;
  padding: 0.1em 0.4em;
  border-radius: 3px;
  border: 1px solid var(--border);
}

[data-theme="light"] .post-body :global(:not(pre) > code) {
  color: #0066aa;
}

.post-body :global(ul),
.post-body :global(ol) {
  padding-left: 1.5rem;
  margin-bottom: 1rem;
  font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif;
  color: var(--text-muted);
}

.post-body :global(li) {
  margin-bottom: 0.4rem;
  font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif;
}

.post-body :global(blockquote) {
  border-left: 3px solid var(--border);
  padding-left: 1rem;
  margin: 1.5rem 0;
  color: var(--text-dim);
  font-style: italic;
  font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif;
}

.post-body :global(a) {
  color: var(--accent);
  text-decoration: none;
}
.post-body :global(a:hover) {
  text-decoration: underline;
}

.post-body :global(hr) {
  border: none;
  border-top: 1px solid var(--border);
  margin: 2rem 0;
}

/* Footer */
.post-footer {
  margin-top: 3rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border);
}

.back-link {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--text-dim);
  letter-spacing: 0.03em;
  transition: color 0.15s;
}
.back-link:hover { color: var(--accent); }
</style>
