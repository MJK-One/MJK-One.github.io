---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allCategories = ['all', ...new Set(posts.map(p => p.data.category))];

const catColor: Record<string, string> = {
  'Spring Boot': 'tb', Java: 'tb', JPA: 'tb', 'Spring Security': 'tb',
  Redis: 'tp', MySQL: 'tg', PostgreSQL: 'tc', Oracle: 'tg',
  Docker: 'tc', AWS: 'to', 'GitHub Actions': 'tg',
  JavaScript: 'to', JWT: 'tv', Architecture: 'tv',
  performance: 'tp', devops: 'tc', architecture: 'tv', troubleshooting: 'tp',
};
---

<BaseLayout title="블로그 — minjun.log" description="민준의 개발 블로그 — Spring Backend, 아키텍처, DevOps">
  <div class="page-wrapper">

    <div class="page-header">
      <h1>Blog</h1>
      <p class="page-desc">개발하면서 배운 것들을 기록합니다.</p>
    </div>

    <div class="filter-bar">
      {allCategories.map(cat => (
        <button class="filter-btn" data-category={cat}>{cat}</button>
      ))}
    </div>

    <hr class="divider" />

    <ul class="post-list" id="posts-list">
      {posts.map(post => {
        const d = post.data.pubDate;
        const dateStr = `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`;
        return (
          <li class="post-item" data-category={post.data.category}>
            <div class="post-top">
              <a href={`/blog/${post.slug}`} class="post-title">{post.data.title}</a>
              <span class="post-date">{dateStr}</span>
            </div>
            <p class="post-excerpt">{post.data.description}</p>
            <div class="post-tags">
              <span class={`tag ${catColor[post.data.category] ?? 'tb'}`}>{post.data.category}</span>
              {post.data.tags.map(tag =>
                <span class={`tag ${catColor[tag] ?? 'tb'}`}>{tag}</span>
              )}
            </div>
          </li>
        );
      })}
    </ul>

  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items   = document.querySelectorAll<HTMLElement>('.post-item');

  function applyFilter(cat: string) {
    buttons.forEach(b => b.classList.remove('active'));
    const target = document.querySelector<HTMLButtonElement>(`[data-category="${cat}"]`);
    (target ?? document.querySelector<HTMLButtonElement>('[data-category="all"]'))!.classList.add('active');
    items.forEach(item => {
      item.style.display =
        cat === 'all' || item.dataset.category === cat ? '' : 'none';
    });
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.category!));
  });

  // URL ?cat= 파라미터 자동 적용
  const urlCat = new URLSearchParams(location.search).get('cat') ?? 'all';
  applyFilter(urlCat);
</script>

<style>
.page-header {
  padding: 3rem 0 1.75rem;
}

.page-header h1 {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 0.4rem;
}

.page-desc {
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.7;
}

.filter-bar {
  display: flex;
  gap: 0.4rem;
  flex-wrap: wrap;
  margin-bottom: 1.25rem;
}

.filter-btn {
  background: none;
  border: 1px solid var(--border);
  color: var(--text-dim);
  font-family: inherit;
  font-size: 12px;
  font-weight: 500;
  padding: 3px 12px;
  border-radius: 20px;
  cursor: pointer;
  transition: all 0.15s;
}

.filter-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.filter-btn.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #0d0f1a;
  font-weight: 600;
}

[data-theme="light"] .filter-btn.active { color: #fff; }

.post-list {
  list-style: none;
  padding-bottom: 5rem;
}
</style>
