---
import BaseLayout from '../layouts/BaseLayout.astro';

const techStack = [
  { category: 'Backend', items: [
    { name: 'Java',          color: 'to' },
    { name: 'Spring Boot',   color: 'tg' },
    { name: 'Spring MVC',    color: 'tg' },
    { name: 'Spring Security', color: 'tb' },
    { name: 'Spring AI',     color: 'tv' },
    { name: 'JPA / Hibernate', color: 'tv' },
    { name: 'QueryDSL',      color: 'tv' },
  ]},
  { category: 'Database', items: [
    { name: 'PostgreSQL', color: 'tc' },
    { name: 'MariaDB',    color: 'tg' },
    { name: 'Redis',      color: 'tp' },
  ]},
  { category: 'Message Queue', items: [
    { name: 'Kafka', color: 'tb' },
  ]},
  { category: 'Infrastructure', items: [
    { name: 'AWS (EC2, RDS, S3, ElastiCache)', color: 'to' },
    { name: 'Docker',                          color: 'tc' },
    { name: 'Linux (리눅스마스터 2급)',         color: 'tg' },
  ]},
  { category: 'Frontend', items: [
    { name: 'React',      color: 'tb' },
    { name: 'JavaScript', color: 'to' },
  ]},
  { category: 'Tools', items: [
    { name: 'Git',           color: 'tp' },
    { name: 'IntelliJ IDEA', color: 'tv' },
    { name: 'GitHub Actions', color: 'tg' },
  ]},
];
---

<BaseLayout title="소개 — minjun.log" description="민준 소개 — Spring 백엔드 개발자">
  <div class="page-wrapper">

    <section class="about-hero">
      <h1>Minjun <span class="name-en"> </span></h1>
      <p class="about-role">Spring Backend Developer</p>
    </section>

    <div class="about-content">

      <section class="about-section">
        <h2>Introduction</h2>
        <p>
          소프트웨어공학 전공과 스파르타코딩클럽 수료를 바탕으로 <strong>Java 백엔드 개발에 집중해온 개발자 김민준</strong>입니다.
          참여한 대부분의 팀 프로젝트에서 조장을 맡아왔으며, 책임감 있게 프로젝트를 수행하고
          팀원 전체가 같이 더 좋은 방식으로 나아갈 수 있도록 소통하는 것을 중요한 가치라고 생각합니다.
        </p>
        <p>
          <strong>DDD·MSA·Redis·Kafka·Spring AI</strong> 연동까지 직접 설계하고 구현한 경험이 있고,
          트랜잭션 분리, N+1 해소, Redis 캐싱 등 <strong>성능과 안정성을 함께 고려하며</strong> 개발을 진행합니다.
          <strong>대용량 트래픽 환경</strong>에서 동시성 문제 해결과 조회 성능 최적화 경험이 있으며,
          <strong>Spring AI + Gemini 연동 챗봇</strong> 구현을 통해 외부 API 통합과 트랜잭션 설계까지 경험했습니다.
          프론트엔드 기획 및 구현 경험을 바탕으로 <strong>API 호출 빈도와 데이터 단위를 고려한 설계</strong>가 가능하며,
          요구사항을 즉각 분석하여 논리적 코드로 구현하는 <strong>라이브 코딩</strong>에 강점이 있습니다.
        </p>
        <p>
          좋은 백엔드 개발자는 코드를 잘 짜는 것을 넘어,
          <strong>명확한 소통과 안정적인 결과물</strong>로 팀에 기여해야 한다고 믿습니다.
          <strong>기술 개선을 운영 효율화로 연결</strong>하는 데 항상 고민하고,
          코드 리뷰와 협업 문화를 통해 <strong>팀 전체의 성장</strong>에 함께 기여하는 개발자가 되겠습니다.
        </p>
      </section>

      <section class="about-section">
        <h2>What I Do</h2>
        <ul class="about-list">
          <li>Java &amp; Spring Boot 기반 RESTful API 설계 및 구현</li>
          <li>DDD 기반 도메인 모델 설계 및 MSA 서비스 분리</li>
          <li>Redis 캐싱 전략 수립 및 DB 조회 성능 최적화</li>
          <li>Spring AI 연동 AI 챗봇 설계 및 외부 API 통합</li>
          <li>Spring Security · JWT 기반 인증/인가 설계</li>
          <li>고동시성 환경에서의 데이터 정합성 확보</li>
          <li>AWS (EC2, RDS, S3) 배포 및 Docker 기반 인프라 구성</li>
          <li>GitHub Actions CI/CD 파이프라인 구성</li>
          <li>팀 프로젝트 리딩 — 기획, 역할 분배, 코드 리뷰</li>
        </ul>
      </section>

      <section class="about-section">
        <h2>Tech Stack</h2>
        <div class="stack-grid">
          {techStack.map(group => (
            <div class="stack-group">
              <span class="stack-category">{group.category}</span>
              <div class="stack-tags">
                {group.items.map(item => (
                  <span class={`tag ${item.color}`}>{item.name}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
.about-hero {
  padding: 3.5rem 0 2.5rem;
  border-bottom: 1px solid var(--border);
  margin-bottom: 2.5rem;
}

.about-hero h1 {
  font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif;
  font-size: 2.2rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--text);
  margin-bottom: 0.4rem;
}

.name-en {
  font-size: 1.4rem;
  color: var(--text-muted);
  font-weight: 400;
}

.about-role {
  font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif;
  font-size: 13px;
  color: #ffffff;
}

.about-content {
  max-width: 620px;
  padding-bottom: 5rem;
}

.about-section {
  margin-bottom: 2.5rem;
}

.about-section h2 {
  font-size: 11px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border);
}

.about-section p {
  font-size: 0.9rem;
  color: #ffffff;
  line-height: 1.85;
  margin-bottom: 0.85rem;
  word-break: keep-all;
}

.about-section p strong {
  color: #ffffff;
  font-weight: 700;
  background: rgba(130, 170, 255, 0.25);
  border-radius: 3px;
  padding: 0.05em 0.35em;
}

.about-list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
}

.about-list li {
  font-size: 0.875rem;
  color: #ffffff;
  padding-left: 1.1rem;
  position: relative;
  line-height: 1.6;
  word-break: keep-all;
}

.about-list li::before {
  content: '·';
  position: absolute;
  left: 0;
  color: var(--accent);
}

.stack-grid {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.stack-group {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.stack-category {
  font-family: 'JetBrains Mono', 'Noto Sans KR', sans-serif;
  font-size: 11px;
  color: #ffffff;
  min-width: 110px;
  padding-top: 3px;
  flex-shrink: 0;
}

.stack-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.links-list {
  display: flex;
  flex-direction: column;
}

.link-row {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.85rem 0;
  border-bottom: 1px solid var(--border);
  transition: opacity 0.15s;
}
.link-row:hover { opacity: 0.7; }

.link-label {
  font-weight: 600;
  font-size: 14px;
  color: var(--text);
  min-width: 70px;
}

.link-url {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--text-dim);
}

@media (max-width: 480px) {
  .stack-group { flex-direction: column; gap: 0.4rem; }
  .stack-category { min-width: auto; }
}
</style>
